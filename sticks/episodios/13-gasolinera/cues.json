[
 {
  "text": "Son las dos de la mañana.",
  "start": 0.0,
  "end": 1.88,
  "sentence": 0
 },
 {
  "text": "Manejas solo por una carretera en",
  "start": 2.52,
  "end": 4.14,
  "sentence": 1
 },
 {
  "text": "medio del desierto,",
  "start": 4.14,
  "end": 4.96,
  "sentence": 1
 },
 {
  "text": "y la aguja de la gasolina ya está en rojo.",
  "start": 4.96,
  "end": 7.54,
  "sentence": 1
 },
 {
  "text": "Entre la oscuridad aparece un",
  "start": 8.66,
  "end": 10.32,
  "sentence": 2
 },
 {
  "text": "letrero: Gasolinera,",
  "start": 10.32,
  "end": 12.02,
  "sentence": 2
 },
 {
  "text": "dos kilómetros.",
  "start": 12.56,
  "end": 13.3,
  "sentence": 2
 },
 {
  "text": "Respiras tranquilo.",
  "start": 14.44,
  "end": 15.48,
  "sentence": 3
 },
 {
  "text": "Llegas.",
  "start": 16.92,
  "end": 17.32,
  "sentence": 4
 },
 {
  "text": "Es una gasolinera vieja,",
  "start": 18.38,
  "end": 19.8,
  "sentence": 5
 },
 {
  "text": "con una sola bomba y un letrero de",
  "start": 20.36,
  "end": 21.86,
  "sentence": 5
 },
 {
  "text": "neón que parpadea.",
  "start": 21.86,
  "end": 22.82,
  "sentence": 5
 },
 {
  "text": "Adentro, un señor de gorra roja te",
  "start": 24.74,
  "end": 27.06,
  "sentence": 6
 },
 {
  "text": "cobra sin decir una palabra.",
  "start": 27.06,
  "end": 28.3,
  "sentence": 6
 },
 {
  "text": "Detrás de él, un reloj marca las dos",
  "start": 29.56,
  "end": 32.12,
  "sentence": 7
 },
 {
  "text": "y diecisiete.",
  "start": 32.12,
  "end": 32.78,
  "sentence": 7
 },
 {
  "text": "Llenas el tanque,",
  "start": 34.1,
  "end": 34.98,
  "sentence": 8
 },
 {
  "text": "guardas tu ticket en la bolsa y",
  "start": 35.56,
  "end": 37.26,
  "sentence": 8
 },
 {
  "text": "vuelves a la carretera.",
  "start": 37.26,
  "end": 38.18,
  "sentence": 8
 },
 {
  "text": "Veinte minutos después,",
  "start": 39.72,
  "end": 40.74,
  "sentence": 9
 },
 {
  "text": "otro letrero.",
  "start": 41.36,
  "end": 42.1,
  "sentence": 9
 },
 {
  "text": "Gasolinera, dos kilómetros.",
  "start": 43.78,
  "end": 45.2,
  "sentence": 10
 },
 {
  "text": "Debe ser otra, piensas.",
  "start": 46.52,
  "end": 48.22,
  "sentence": 11
 },
 {
  "text": "Pero es la misma.",
  "start": 49.58,
  "end": 50.4,
  "sentence": 12
 },
 {
  "text": "La misma bomba,",
  "start": 51.72,
  "end": 52.84,
  "sentence": 13
 },
 {
  "text": "el mismo neón.",
  "start": 53.3,
  "end": 54.06,
  "sentence": 13
 },
 {
  "text": "Y en el piso, junto a la bomba,",
  "start": 54.06,
  "end": 57.16,
  "sentence": 14
 },
 {
  "text": "está tu ticket.",
  "start": 57.16,
  "end": 57.46,
  "sentence": 14
 },
 {
  "text": "El señor de la gorra roja levanta la",
  "start": 59.14,
  "end": 61.04,
  "sentence": 15
 },
 {
  "text": "vista y dice: otra vez tú.",
  "start": 61.04,
  "end": 62.94,
  "sentence": 15
 },
 {
  "text": "El reloj sigue marcando las dos y diecisiete.",
  "start": 64.14,
  "end": 66.92,
  "sentence": 16
 },
 {
  "text": "Te subes al coche,",
  "start": 68.42,
  "end": 69.52,
  "sentence": 17
 },
 {
  "text": "das media vuelta y aceleras en",
  "start": 70.06,
  "end": 71.74,
  "sentence": 17
 },
 {
  "text": "dirección contraria.",
  "start": 71.74,
  "end": 72.72,
  "sentence": 17
 },
 {
  "text": "Esta vez no te vas a detener.",
  "start": 73.46,
  "end": 75.24,
  "sentence": 18
 },
 {
  "text": "Gasolinera, dos kilómetros.",
  "start": 76.8,
  "end": 78.14,
  "sentence": 19
 },
 {
  "text": "Esta vez ya hay un coche en la bomba.",
  "start": 79.14,
  "end": 81.2,
  "sentence": 20
 },
 {
  "text": "Es igual al tuyo,",
  "start": 81.86,
  "end": 83.1,
  "sentence": 21
 },
 {
  "text": "con la misma placa.",
  "start": 83.5,
  "end": 84.3,
  "sentence": 21
 },
 {
  "text": "Y junto a él, alguien con tu ropa",
  "start": 85.06,
  "end": 87.3,
  "sentence": 22
 },
 {
  "text": "está llenando el tanque.",
  "start": 87.3,
  "end": 88.36,
  "sentence": 22
 },
 {
  "text": "El señor de la gorra roja suspira.",
  "start": 89.56,
  "end": 91.2,
  "sentence": 23
 },
 {
  "text": "Ya van muchas vueltas esta noche, te dice.",
  "start": 92.3,
  "end": 94.74,
  "sentence": 24
 },
 {
  "text": "Y el reloj sigue marcando las dos y diecisiete.",
  "start": 95.68,
  "end": 97.92,
  "sentence": 25
 }
]