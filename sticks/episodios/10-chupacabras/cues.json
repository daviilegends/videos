 },
 {
  "text": "con pequeños agujeros en el cuello.",
  "start": 5.16,
  "end": 6.78,
  "sentence": 0
 },
 {
  "text": "Durante los años noventa,",
  "start": 8.06,
  "end": 8.82,
  "sentence": 1
 },
 {
  "text": "México comenzó a escuchar una",
  "start": 9.82,
  "end": 11.12,
  "sentence": 1
 },
 {
  "text": "historia que parecía sacada de una",
  "start": 11.12,
