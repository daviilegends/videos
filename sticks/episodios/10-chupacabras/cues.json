  "sentence": 1
 },
 {
  "text": "película de ciencia ficción.",
  "start": 12.66,
  "end": 13.92,
  "sentence": 1
 },
 {
  "text": "En distintas comunidades se",
  "start": 15.04,
  "end": 16.52,
  "sentence": 2
 },
 {
  "text": "reportaba la muerte de animales de granja.",
  "start": 16.52,
  "end": 18.36,
  "sentence": 2
 },
 {
  "text": "Algunos testimonios aseguraban que",
  "start": 19.78,
  "end": 21.42,
  "sentence": 3
 },
 {
  "text": "los cuerpos tenían heridas extrañas,",
  "start": 21.42,
  "end": 23.1,
  "sentence": 3
 },
 {
  "text": "y que algo los había atacado durante la noche.",
  "start": 23.1,
  "end": 25.46,
  "sentence": 3
 },
 {
  "text": "Pronto apareció un nombre que todos",
  "start": 26.6,
  "end": 28.38,
  "sentence": 4
 },
 {
  "text": "comenzaron a repetir.",
  "start": 28.38,
  "end": 29.54,
  "sentence": 4
 },
 {
  "text": "El Chupacabras.",
  "start": 29.94,
  "end": 31.9,
  "sentence": 5
 },
 {
  "text": "La historia había comenzado en",
  "start": 33.48,
  "end": 34.86,
  "sentence": 6
 },
 {
  "text": "Puerto Rico, a mediados de los años noventa.",
  "start": 34.86,
  "end": 37.04,
  "sentence": 6
 },
 {
  "text": "Pero muy rápido llegó a México y a",
  "start": 38.42,
  "end": 40.16,
  "sentence": 7
 },
 {
  "text": "otros países.",
  "start": 40.16,
  "end": 40.8,
  "sentence": 7
 },
 {
  "text": "Los relatos describían una criatura",
  "start": 42.26,
  "end": 43.9,
  "sentence": 8
 },
 {
  "text": "extraña, con ojos inquietantes,",
  "start": 43.9,
  "end": 45.96,
  "sentence": 8
 },
 {
  "text": "aspecto de reptil y espinas en la espalda.",
  "start": 46.5,
  "end": 48.52,
  "sentence": 8
 },
 {
  "text": "Decían que se alimentaba de la",
  "start": 49.12,
  "end": 50.56,
  "sentence": 9
 },
 {
  "text": "sangre de los animales.",
  "start": 50.56,
  "end": 51.46,
  "sentence": 9
 },
 {
  "text": "La televisión y los periódicos",
  "start": 51.46,
  "end": 54.36,
  "sentence": 10
 },
 {
  "text": "difundieron testimonios,",
  "start": 54.36,
  "end": 56.04,
  "sentence": 10
 },
 {
  "text": "fotografías y supuestos",
  "start": 56.44,
  "end": 57.74,
  "sentence": 10
 },
 {
  "text": "avistamientos.",
  "start": 57.74,
  "end": 58.42,
  "sentence": 10
 },
 {
  "text": "El tema se convirtió en un fenómeno nacional.",
  "start": 59.72,
  "end": 62.06,
  "sentence": 11
 },
 {
  "text": "Algunas personas aseguraban haberlo visto.",
  "start": 63.52,
  "end": 65.48,
  "sentence": 12
 },
 {
  "text": "Otras estaban convencidas de que era",
  "start": 66.54,
  "end": 68.24,
  "sentence": 13
 },
 {
  "text": "un experimento secreto.",
  "start": 68.24,
  "end": 69.42,
  "sentence": 13
 },
 {
  "text": "Pero con el tiempo aparecieron",
  "start": 69.9,
  "end": 71.4,
  "sentence": 14
 },
 {
  "text": "explicaciones más terrenales.",
  "start": 71.4,
  "end": 72.76,
  "sentence": 14
 },
 {
  "text": "Al revisar animales señalados como",
  "start": 73.62,
  "end": 75.36,
  "sentence": 15
 },
 {
  "text": "chupacabras, los investigadores",
  "start": 75.36,
  "end": 77.26,
  "sentence": 15
 },
 {
  "text": "encontraron coyotes y perros con",
  "start": 77.26,
  "end": 78.88,
  "sentence": 15
 },
 {
  "text": "sarna severa.",
  "start": 78.88,
  "end": 79.56,
  "sentence": 15
 },
 {
  "text": "Es una enfermedad que les hace",
  "start": 80.2,
  "end": 81.62,
  "sentence": 16
 },
 {
  "text": "perder el pelo y cambia por completo su aspecto.",
  "start": 81.62,
  "end": 84.8,
  "sentence": 16
 },
 {
  "text": "Nunca se confirmó científicamente",
  "start": 85.82,
  "end": 87.74,
  "sentence": 17
 },
 {
  "text": "que aquella criatura existiera.",
  "start": 87.74,
  "end": 89.12,
  "sentence": 17
 },
 {
  "text": "Sin embargo, el Chupacabras ya había",
  "start": 90.26,
  "end": 91.82,
  "sentence": 18
 },
 {
  "text": "conseguido algo extraordinario.",
  "start": 91.82,
  "end": 93.26,
  "sentence": 18
 },
 {
  "text": "Convertirse en uno de los misterios",
  "start": 94.02,
  "end": 95.64,
  "sentence": 19
 },
 {
  "text": "más famosos de la cultura popular mexicana.",
  "start": 95.64,
  "end": 97.72,
  "sentence": 19
 },
 {
  "text": "¿Tú recuerdas cuando todos hablaban",
  "start": 98.82,
  "end": 100.52,
  "sentence": 20
 },
 {
  "text": "del Chupacabras?",
  "start": 100.52,
