[
 {
  "text": "Tienes un jardín vacío y quieres una alberca.",
  "start": 0.74,
  "end": 2.9,
  "sentence": 0
 },
 {
  "text": "Primero marcas la forma con estacas y cuerda.",
  "start": 3.54,
  "end": 5.64,
  "sentence": 1
 },
 {
  "text": "Eso se llama trazo.",
  "start": 6.12,
  "end": 7.2,
  "sentence": 2
 },
 {
  "text": "Luego excavas.",
  "start": 8.2,
  "end": 8.6,
  "sentence": 3
 },
 {
  "text": "Pero si cavas paredes rectas,",
  "start": 10.34,
  "end": 11.76,
  "sentence": 4
 },
 {
  "text": "la tierra se derrumba.",
  "start": 12.28,
  "end": 13.06,
  "sentence": 4
 },
 {
  "text": "Entonces cortas las paredes un poco",
  "start": 14.1,
  "end": 15.74,
  "sentence": 5
 },
 {
  "text": "inclinadas, para que la tierra no se caiga.",
  "start": 15.74,
  "end": 17.92,
  "sentence": 5
 },
 {
  "text": "Eso es un talud.",
  "start": 18.46,
  "end": 19.26,
  "sentence": 6
 },
 {
  "text": "En el fondo pones grava y la",
  "start": 20.28,
  "end": 21.7,
  "sentence": 7
 },
 {
  "text": "compactas, para que el piso no se hunda.",
  "start": 21.7,
  "end": 23.8,
  "sentence": 7
 },
 {
  "text": "Pero el concreto solo se agrieta con",
  "start": 24.6,
  "end": 26.76,
  "sentence": 8
 },
 {
  "text": "el peso del agua.",
  "start": 26.76,
  "end": 27.44,
  "sentence": 8
 },
 {
  "text": "Entonces colocas una malla de",
  "start": 28.84,
  "end": 30.34,
  "sentence": 9
 },
 {
  "text": "varillas de acero.",
  "start": 30.34,
  "end": 30.98,
  "sentence": 9
 },
 {
  "text": "Eso se llama armado.",
  "start": 31.66,
  "end": 33.46,
  "sentence": 10
 },
 {
  "text": "Después lanzas el concreto sobre el",
  "start": 34.76,
  "end": 36.28,
  "sentence": 11
 },
 {
  "text": "armado, piso y paredes en una sola pieza.",
  "start": 36.28,
  "end": 38.02,
  "sentence": 11
 },
 {
  "text": "Pero el concreto deja pasar el agua",
  "start": 38.76,
  "end": 40.54,
  "sentence": 12
 },
 {
  "text": "poco a poco.",
  "start": 40.54,
  "end": 41.08,
  "sentence": 12
 },
 {
  "text": "Entonces lo cubres con un",
  "start": 42.28,
  "end": 43.56,
  "sentence": 13
 },
 {
  "text": "impermeabilizante.",
  "start": 43.56,
  "end": 44.32,
  "sentence": 13
 },
 {
  "text": "Instalas las tuberías.",
  "start": 45.44,
  "end": 46.48,
  "sentence": 14
 },
 {
  "text": "El agua sale por el fondo,",
  "start": 47.44,
  "end": 48.56,
  "sentence": 15
 },
 {
  "text": "pasa por un filtro y regresa limpia.",
  "start": 49.02,
  "end": 50.9,
  "sentence": 15
 },
 {
  "text": "Pones el azulejo y llenas de agua.",
  "start": 51.82,
  "end": 53.72,
  "sentence": 16
 },
 {
  "text": "Felicidades, construiste una alberca.",
  "start": 54.54,
  "end": 56.76,
  "sentence": 17
 }
]